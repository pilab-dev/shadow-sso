# ============================================
# Shadow SSO Environment Configuration
# ============================================
#
# 🔐 Secrets are managed via KeePassXC vault (~/Workspace/Passwords.kdbx, group: shadow-sso/)
#    Retrieve with: keepassxc-cli show ~/Workspace/Passwords.kdbx shadow-sso/<entry> -p
#
# All environment variables use the SSSO_ prefix for consistency

# ============================================
# Core SSO Configuration
# ============================================
SSSO_HTTP_ADDR=0.0.0.0:8080
SSSO_LOG_LEVEL=info
SSSO_MONGO_URI=mongodb://localhost:27017
SSSO_MONGO_DB_NAME=shadow_sso_db
SSSO_STORAGE_BACKEND=mongodb
SSSO_ISSUER_URL=https://sso.example.com
SSSO_SIGNING_KEY_PATH=/etc/sso/keys/private.pem
SSSO_ACCESS_TOKEN_TTL=1h
SSSO_REFRESH_TOKEN_TTL=720h
SSSO_SECURITY_PASSWORD_HASH_COST=12
SSSO_DTS_CLIENT_ADDRESS=ssso-dts:50051
SSSO_DTS_TIMEOUT=5s
SSSO_NEXTJS_LOGIN_URL=https://login.example.com

# ============================================
# Notification Services
# ============================================
SSSO_RESEND_API_KEY=your_resend_api_key_here
SSSO_FROM_EMAIL=noreply@yourdomain.com
SSSO_NEXT_PUBLIC_BASE_URL=https://yourdomain.com
SSSO_TWILIO_ACCOUNT_SID=your_twilio_account_sid
SSSO_TWILIO_AUTH_TOKEN=your_twilio_auth_token
SSSO_TWILIO_PHONE_NUMBER=+1234567890
SSSO_FIREBASE_PROJECT_ID=your_firebase_project_id
SSSO_FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json

# ============================================
# Initial Admin Setup
# ============================================
SSSO_INITIAL_ADMIN_ENABLED=false
SSSO_INITIAL_ADMIN_EMAIL=admin@example.com
SSSO_INITIAL_ADMIN_PASSWORD=change-me-immediately
SSSO_INITIAL_ADMIN_FIRST_NAME=Admin
SSSO_INITIAL_ADMIN_LAST_NAME=User
