# Copy to .env for Docker Compose. 'docker compose up' reads .env automatically.
#
# ============================================
# Shadow SSO Environment Configuration
# ============================================
#
# 🔐 Secrets are managed via KeePassXC vault (~/Workspace/Passwords.kdbx, group: shadow-sso/)
#    Retrieve with: keepassxc-cli show ~/Workspace/Passwords.kdbx shadow-sso/<entry> -p
#
# All environment variables use the SSSO_ prefix for consistency

# ============================================
# Core SSO Configuration
# ============================================
SSSO_HTTP_ADDR=0.0.0.0:8080
SSSO_MGMT_HTTP_ADDR=:5000
SSSO_LOG_LEVEL=debug
SSSO_JSON_LOG=false
SSSO_ISSUER_URL=http://localhost:8080
SSSO_MONGO_URI=mongodb://mongo:27017
SSSO_MONGO_DB_NAME=shadow_sso_dev
SSSO_STORAGE_BACKEND=mongodb
SSSO_ACCESS_TOKEN_TTL=1h
SSSO_REFRESH_TOKEN_TTL=720h
SSSO_SECURITY_PASSWORD_HASH_COST=12
SSSO_DTS_CLIENT_ADDRESS=ssso-dts:50051
SSSO_DTS_TIMEOUT=5s
SSSO_NEXTJS_LOGIN_URL=http://localhost:3000/login

# ============================================
# Identity source
# ============================================
# "local" (default) keeps users and passwords in MongoDB. "pirectory" reads
# identity from PiRectory over accounts.v1/credentials.v1: the directory owns
# the password, the attributes and the groups, and ShadowSSO keeps only its
# own state (MFA, required actions, WebAuthn, local roles) keyed by the
# directory object id. See docs/architecture/16-shadow-sso-identity-source.md
# in the PiRectory repository.
SSSO_IDENTITY_SOURCE=local
# SSSO_DIRECTORY_ADDR=https://127.0.0.1:7443
# SSSO_DIRECTORY_CA_FILE=/etc/sso/pirectory-ca.pem
# SSSO_DIRECTORY_CERT_FILE=/etc/sso/shadowsso.pem
# SSSO_DIRECTORY_KEY_FILE=/etc/sso/shadowsso.key
# SSSO_DIRECTORY_ACTOR_KEY_FILE=/etc/sso/shadowsso-actor.key
# SSSO_DIRECTORY_TIMEOUT=5s

# ============================================
# Notification Services
# Optional — remove if not using email/SMS/push notifications
# ============================================
# SSSO_RESEND_API_KEY=
# SSSO_FROM_EMAIL=noreply@example.com
# SSSO_NEXT_PUBLIC_BASE_URL=http://localhost:3000
# SSSO_TWILIO_ACCOUNT_SID=
# SSSO_TWILIO_AUTH_TOKEN=
# SSSO_TWILIO_PHONE_NUMBER=
# SSSO_FIREBASE_PROJECT_ID=
# SSSO_FIREBASE_CREDENTIALS_PATH=

# ============================================
# Initial Admin Setup
# ============================================
SSSO_INITIAL_ADMIN_ENABLED=true
SSSO_INITIAL_ADMIN_EMAIL=admin@localhost
SSSO_INITIAL_ADMIN_PASSWORD=admin
SSSO_INITIAL_ADMIN_FIRST_NAME=Admin
SSSO_INITIAL_ADMIN_LAST_NAME=User
