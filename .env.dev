# Local Development Environment Variables
# This file is used by docker-compose.dev.yml
# Copy to .env.dev.local for local overrides

# MongoDB
MONGO_URI=mongodb://mongo:27017
SSSO_MONGO_URI=mongodb://mongo:27017
SSSO_MONGO_DB_NAME=shadow_sso_dev

# Server
SSSO_ISSUER_URL=http://localhost:8080
SSSO_HTTP_ADDR=0.0.0.0:8080
SSSO_MGMT_HTTP_ADDR=:5000
SSSO_LOG_LEVEL=debug
SSSO_JSON_LOG=false

# Security
SSSO_SIGNING_KEY_PATH=/etc/sso/keys/private.pem
SSSO_CONFIG_ENCRYPTION_KEY=dev-encryption-key-32-chars-long
SSSO_KEY_ROTATION_INTERVAL=24h
SSSO_ACCESS_TOKEN_TTL=1h
SSSO_REFRESH_TOKEN_TTL=720h

# Initial Admin Bootstrap
SSSO_INITIAL_ADMIN_ENABLED=true
SSSO_INITIAL_ADMIN_EMAIL=admin@localhost
SSSO_INITIAL_ADMIN_PASSWORD=admin123
SSSO_INITIAL_ADMIN_FIRST_NAME=Admin
SSSO_INITIAL_ADMIN_LAST_NAME=User

# CORS
SSSO_ALLOWED_ORIGINS=["*"]

# Storage
SSSO_STORAGE_BACKEND=mongodb

# External Services (optional - leave empty for local dev)
SSSO_NEXTJS_LOGIN_URL=
SSSO_RESEND_API_KEY=
SSSO_FROM_EMAIL=
SSSO_NEXT_PUBLIC_BASE_URL=
SSSO_TWILIO_ACCOUNT_SID=
SSSO_TWILIO_AUTH_TOKEN=
SSSO_TWILIO_PHONE_NUMBER=
SSSO_FIREBASE_PROJECT_ID=
SSSO_FIREBASE_CREDENTIALS_PATH=

# Tracing
SSSO_TRACING_ENABLED=false
SSSO_TRACING_OTLP_ENDPOINT=